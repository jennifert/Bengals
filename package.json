{
  "name": "bengal-fan-page",
  "version": "0.1.0",
  "description": "A fun, accessible fan site dedicated to Bengal cats — affectionately known as **danger floofs**, **chaos menaces**, and tiny household leopards.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write src eslint.config.mjs playwright.config.mjs package.json",
    "format:check": "prettier --check src eslint.config.mjs playwright.config.mjs package.json",
    "test:a11y": "playwright test",
    "check": "npm run lint && npm run format:check && npm run build && npm run test:a11y"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jennifert/Bengals.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/jennifert/Bengals/issues"
  },
  "homepage": "https://github.com/jennifert/Bengals#readme",
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1"
  }
}
